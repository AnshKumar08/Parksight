# ParkSight Frontend Environment Configuration
# Base URL for the Spring Boot backend service
VITE_API_URL=https://parksight-backend-sypc.onrender.com

# Optional: CARTO Basemap API Key.
# If omitted, OpenStreetMap standard raster tiles with high-contrast tactical styling are used (no key required, no watermarks).
# If you obtain a free Carto key at https://carto.com/carto-basemaps-api-key, paste it below.
# VITE_CARTO_API_KEY=your_carto_api_key_here
